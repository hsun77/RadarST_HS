{
  "evidence": {
    "candidate_gates": {
      "singleton": {
        "boundary_percentile_min": 0.85,
        "proposal_percentile_min": 0.65,
        "minimum_island_support_methods": 2,
        "minimum_rare_support_methods_alternative": 4
      },
      "multispot": {
        "boundary_percentile_min": 0.7,
        "proposal_percentile_min": 0.5,
        "minimum_island_support_methods": 1,
        "minimum_rare_support_methods_alternative": 2
      },
      "sensor_method_denominator": 14
    },
    "candidate_input": {
      "allowed_columns": [
        "dataset_id",
        "sample_id",
        "candidate_id",
        "proposal_type",
        "member_spots",
        "n_spots",
        "proposal_score",
        "sensor_boundary_mean",
        "sensor_boundary_q75",
        "sensor_island_support_frac",
        "sensor_rare_support_frac",
        "sensor_bg_same_mean",
        "sensor_candidate_label_entropy",
        "local_background_neighbor_count"
      ],
      "truth_derived_columns_forbidden": [
        "training_best_IoU",
        "training_best_F1",
        "training_best_component_id",
        "loso_predicted_IoU",
        "sensor_loso_predicted_IoU"
      ]
    }
  },
  "risk": {
    "relaxed_truth_independent_evidence_gate": {
      "singleton": {
        "boundary_percentile_min": 0.75,
        "proposal_percentile_min": 0.5,
        "minimum_island_support_methods": 1,
        "minimum_rare_support_methods_alternative": 2
      },
      "multispot": {
        "boundary_percentile_min": 0.55,
        "proposal_percentile_min": 0.35,
        "minimum_island_support_methods": 1,
        "minimum_rare_support_methods_alternative": 1
      },
      "sensor_method_denominator": 14
    },
    "utility": {
      "formula": "0.55*evidence_score + 0.45*safety_score",
      "minimum_utility": 0.55,
      "ranking": [
        "writeback_utility descending",
        "evidence_score descending",
        "safety_score descending",
        "candidate_id ascending"
      ]
    },
    "budget": {
      "primary_maximum_unique_modified_fraction": 0.1,
      "budget_is_safety_ceiling_not_fill_target": true
    }
  }
}
